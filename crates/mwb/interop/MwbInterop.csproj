<Project Sdk="Microsoft.NET.Sdk">
  <!-- Test harness for wire compatibility of the Rust `mwb` crate with PowerToys
       Mouse Without Borders. The protocol code in MwbCore.cs is copied verbatim
       (minus logging/UI) from src/modules/MouseWithoutBorders/App/Core and Class. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>SYSLIB0021;CA1416</NoWarn>
    <RollForward>Major</RollForward>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
</Project>
